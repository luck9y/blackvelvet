<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Staff Verification — Black Velvet</title>

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
    body {
        background: #0d0d0d;
        color: white;
        font-family: Arial, sans-serif;
        text-align: center;
        padding-top: 60px;
    }

    h1 {
        font-family: 'Press Start 2P', cursive;
        font-size: 26px;
        margin-bottom: 20px;
        letter-spacing: 2px;
        text-shadow: 0 0 10px #fff;
    }

    /* Glowing display */
    #display {
        width: 200px;
        height: 40px;
        margin: 20px auto;
        background: #111;
        border: 2px solid #444;
        border-radius: 6px;
        font-size: 20px;
        font-family: 'Press Start 2P', cursive;
        color: white;
        text-align: center;
        line-height: 40px;
        box-shadow: 0 0 10px #ffffff55;
    }

    .numpad {
        width: 200px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    /* Glowing numpad buttons */
    .btn {
        background: #111;
        border: 2px solid #444;
        border-radius: 6px;
        padding: 20px;
        font-family: 'Press Start 2P', cursive;
        color: white;
        cursor: pointer;
        transition: 0.2s;
        box-shadow: 0 0 8px #ffffff33;
    }

    .btn:hover {
        background: #222;
        border-color: #fff;
        box-shadow: 0 0 12px #ffffffaa;
        transform: scale(1.05);
    }

    /* Glowing ENTER button */
    #enter {
        margin-top: 20px;
        width: 200px;
        padding: 15px;
        background: #222;
        border: 2px solid #fff;
        border-radius: 6px;
        font-family: 'Press Start 2P', cursive;
        cursor: pointer;
        color: white;
        font-size: 14px;
        box-shadow: 0 0 12px #ffffff55;
        transition: 0.2s;
    }

    #enter:hover {
        background: #333;
        box-shadow: 0 0 18px #ffffffaa;
        transform: scale(1.05);
    }

    #error {
        margin-top: 20px;
        color: red;
        font-family: 'Press Start 2P', cursive;
        font-size: 12px;
        text-shadow: 0 0 10px #ff0000aa;
    }
</style>
</head>

<body>

<h1>STAFF VERIFICATION</h1>

<div id="display"></div>

<div class="numpad">
    <div class="btn" onclick="press('1')">1</div>
    <div class="btn" onclick="press('2')">2</div>
    <div class="btn" onclick="press('3')">3</div>
    <div class="btn" onclick="press('4')">
