<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>Staff Verification — Black Velvet</title>

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

<style>
    body {
        background: #0d0d0d;
        color: white;
        font-family: Arial, sans-serif;
        text-align: center;
        padding-top: 60px;
    }

    h1 {
        font-family: 'Press Start 2P', cursive;
        font-size: 26px;
        margin-bottom: 20px;
        letter-spacing: 2px;
    }

    #display {
        width: 200px;
        height: 40px;
        margin: 20px auto;
        background: #111;
        border: 2px solid #444;
        border-radius: 6px;
        font-size: 20px;
        font-family: 'Press Start 2P', cursive;
        color: white;
        text-align: center;
        line-height: 40px;
    }

    .numpad {
        width: 200px;
        margin: auto;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 10px;
    }

    .btn {
        background: #111;
        border: 2px solid #444;
        border-radius: 6px;
        padding: 20px;
        font-family: 'Press Start 2P', cursive;
        color: white;
        cursor: pointer;
        transition: 0.2s;
    }

    .btn:hover {
        background: #222;
        border-color: #fff;
    }

    #enter {
        margin-top: 20px;
        width: 200px;
        padding: 15px;
        background: #222;
        border: 2px solid #fff;
        border-radius: 6px;
        font-family: 'Press Start 2P', cursive;
        cursor: pointer;
        color: white;
        font-size: 14px;
    }

    #enter:hover {
        background: #333;
    }

    #error {
        margin-top: 20px;
        color: red;
        font-family: 'Press Start 2P', cursive;
        font-size: 12px;
    }
</style>
</head>

<body>

<h1>STAFF VERIFICATION</h1>

<div id="display"></div>

<div class="numpad">
    <div class="btn" onclick="press('1')">1</div>
    <div class="btn" onclick="press('2')">2</div>
    <div class="btn" onclick="press('3')">3</div>
    <div class="btn" onclick="press('4')">4</div>
    <div class="btn" onclick="press('5')">5</div>
    <div class="btn" onclick="press('6')">6</div>
    <div class="btn" onclick="press('7')">7</div>
    <div class="btn" onclick="press('8')">8</div>
    <div class="btn" onclick="press('9')">9</div>
    <div class="btn" onclick="press('0')">0</div>
</div>

<button id="enter" onclick="verify()">ENTER</button>

<div id="error"></div>

<script>
let code = "";

function press(num) {
    if (code.length < 4) {
        code += num;
        document.getElementById("display").innerText = code;
    }
}

function verify() {
    if (code === "9033") {
        window.location.href = "staffapp.html";
    } else {
        document.getElementById("error").innerText = "Incorrect code.";
        code = "";
        document.getElementById("display").innerText = "";
    }
}
</script>

</body>
</html>
